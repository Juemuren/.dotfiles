{
  "mathbb": {
    "prefix": "bb",
    "body": "\\mathbb{${1}}"
  },
  "mathbf": {
    "prefix": "bf",
    "body": "\\mathbf{${1}}"
  },
  "mathbm": {
    "prefix": "bm",
    "body": "\\boldsymbol{${1}}"
  },
  "mathcal": {
    "prefix": "cal",
    "body": "\\mathcal{${1}}"
  },
  "mathrm": {
    "prefix": "rm",
    "body": "\\mathrm{${1}}"
  },
  "matrix": {
    "prefix": "matrix",
    "body": [
      "\\begin{${1:matrix}}",
      "  ${2}11 & ${2}12 & \\cdots & ${2}1n \\\\\\",
      "  ${2}21 & ${2}22 & \\cdots & ${2}2n \\\\\\",
      "  \\vdots & \\vdots & \\ddots & \\vdots \\\\\\",
      "  ${2}n1 & ${2}n2 & \\cdots & ${2}nn \\\\\\",
      "\\end{${1:matrix}}"
    ]
  },
  "set": {
    "prefix": "set",
    "body": "\\\\${1:set}{${2}1, ${2}2, \\cdots, ${2}n}"
  },
  "sum": {
    "prefix": "sum",
    "body": "${1}1 ${2:+} ${1}2 ${2:+} \\cdots ${2:+} ${1}n"
  },
  "derivative": {
    "prefix": ["derivative", "deriv"],
    "body": "\\frac{\\mathrm{d}${1:y}}{\\mathrm{d}${2:x}}"
  },
  "n-derivative": {
    "prefix": ["n-derivative", "nd"],
    "body": "\\frac{\\mathrm{d}^${3:n} ${1:y}}{\\mathrm{d}${2:x}^${3:n}}"
  },
  "partial-derivative": {
    "prefix": ["partial-derivative", "pd"],
    "body": "\\frac{\\partial ${1:y}}{\\partial ${2:x}}"
  },
  "n-partial-derivative": {
    "prefix": ["n-partial-derivative", "npd"],
    "body": "\\frac{\\partial^${3:n} ${1:y}}{\\partial ${2:x}^${3:n}}"
  },
  "integration": {
    "prefix": ["integration", "int"],
    "body": "\\int_{${1:a}}^{${2:b}} ${4:f} \\mathrm{d}${3:x}"
  },
  "differentiation": {
    "prefix": ["differentiation", "diff"],
    "body": "\\mathrm{d}${1:y} = ${3:f} \\mathrm{d}${2:x}"
  },
  "round-bracket": {
    "prefix": ["round-bracket", "paren", "rb"],
    "body": "\\left( $1 \\right)"
  },
  "square-bracket": {
    "prefix": ["square-bracket", "brack", "sb"],
    "body": "\\left[ $1 \\right]"
  },
  "curly-bracket": {
    "prefix": ["curly-bracket", "brace", "cb"],
    "body": "\\left\\{ $1 \\right\\\\}"
  },
  "angle-bracket": {
    "prefix": ["angle-bracket", "angle", "ab"],
    "body": "\\left\\langle $1 \\right\\rangle"
  },
  "single-bar": {
    "prefix": ["single-bar", "vert", "sb"],
    "body": "\\left\\lvert $1 \\right\\rvert"
  },
  "double-bar": {
    "prefix": ["double-bar", "Vert", "db"],
    "body": "\\left\\lVert $1 \\right\\rVert"
  }
}
