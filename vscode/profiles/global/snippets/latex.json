{
  "mathbb": {
    "prefix": "bb",
    "body": "\\mathbb{$1}"
  },
  "mathbf": {
    "prefix": "bf",
    "body": "\\mathbf{$1}"
  },
  "mathbm": {
    "prefix": "bm",
    "body": "\\boldsymbol{$1}"
  },
  "mathcal": {
    "prefix": "cal",
    "body": "\\mathcal{$1}"
  },
  "mathrm": {
    "prefix": "rm",
    "body": "\\mathrm{$1}"
  },
  "auto-round-bracket": {
    "prefix": ["arb", "a()"],
    "body": "\\left( $1 \\right)"
  },
  "big-round-bracket": {
    "prefix": ["brb", "b()"],
    "body": "\\bigl( $1 \\bigr)"
  },
  "auto-square-bracket": {
    "prefix": ["asb", "a[]"],
    "body": "\\left[ $1 \\right]"
  },
  "big-square-bracket": {
    "prefix": ["bsb", "b[]"],
    "body": "\\bigl[ $1 \\bigr]"
  },
  "auto-curly-bracket": {
    "prefix": ["acb", "a{}"],
    "body": "\\left\\{ $1 \\right\\\\}"
  },
  "big-curly-bracket": {
    "prefix": ["bcb", "b{}"],
    "body": "\\bigl\\{ $1 \\bigr\\\\}"
  },
  "angle-bracket": {
    "prefix": ["angle", "<>"],
    "body": "\\left\\langle $1 \\right\\rangle"
  },
  "single-vert": {
    "prefix": ["sv", "|"],
    "body": "\\left\\lvert $1 \\right\\rvert"
  },
  "double-vert": {
    "prefix": ["dv", "||"],
    "body": "\\left\\lVert $1 \\right\\rVert"
  },
  "right-vert": {
    "prefix": ["rv", ".|"],
    "body": "\\left. $1 \\right\\rvert"
  },
  "matrix": {
    "prefix": "mat",
    "body": [
      "\\begin{${1:bmatrix}}",
      "  ${2}11 & ${2}12 & \\cdots & ${2}1${4:n} \\\\\\",
      "  ${2}21 & ${2}22 & \\cdots & ${2}2${4:n} \\\\\\",
      "  \\vdots & \\vdots & \\ddots & \\vdots \\\\\\",
      "  ${2}${3:m}1 & ${2}${3:m}2 & \\cdots & ${2}${3:m}${4:n} \\\\\\",
      "\\end{${1:bmatrix}}"
    ],
    "description": "m*n matrix with row-col index order"
  },
  "transpose-matrix": {
    "prefix": "mat^T",
    "body": [
      "\\begin{${1:bmatrix}}",
      "  ${2}11 & ${2}21 & \\cdots & ${2}${4:m}1 \\\\\\",
      "  ${2}12 & ${2}22 & \\cdots & ${2}${4:m}2 \\\\\\",
      "  \\vdots & \\vdots & \\ddots & \\vdots \\\\\\",
      "  ${2}1${3:n} & ${2}2${3:n} & \\cdots & ${2}${4:m}${3:n} \\\\\\",
      "\\end{${1:bmatrix}}"
    ],
    "description": "n*m matrix with col-row index order"
  },
  "vector": {
    "prefix": "vec",
    "body": [
      "\\begin{${1:bmatrix}}",
      "  ${2}1 \\\\\\",
      "  ${2}2 \\\\\\",
      "  \\vdots \\\\\\",
      "  ${2}${3:n} \\\\\\",
      "\\end{${1:bmatrix}}"
    ]
  },
  "transpose-vector": {
    "prefix": "vec^T",
    "body": [
      "\\begin{${1:bmatrix}}",
      "  ${2}1 &",
      "  ${2}2 &",
      "  \\cdots &",
      "  ${2}${3:n} &",
      "\\end{${1:bmatrix}}"
    ]
  },
  "sequence": {
    "prefix": "seq",
    "body": "${1}1, ${1}2, \\cdots, ${1}n"
  },
  "sequence-double": {
    "prefix": "seq2",
    "body": "${1}11, ${1}22, \\cdots, ${1}${3:n}${3:n}"
  },
  "sum": {
    "prefix": "sum",
    "body": "${1}1 ${2:+} ${1}2 ${2:+} \\cdots ${2:+} ${1}n"
  },
  "sum-double": {
    "prefix": "sum2",
    "body": "${1}11 ${2:+} ${1}22 ${2:+} \\cdots ${2:+} ${1}${3:n}${3:n}"
  },
  "derivative": {
    "prefix": "deriv",
    "body": "\\frac{\\mathrm{d}${1:y}}{\\mathrm{d}${2:x}}"
  },
  "n-derivative": {
    "prefix": "deriv^n",
    "body": "\\frac{\\mathrm{d}^${3:n} ${1:y}}{\\mathrm{d}${2:x}^${3:n}}"
  },
  "partial-derivative": {
    "prefix": "pd",
    "body": "\\frac{\\partial ${1:y}}{\\partial ${2:x}}"
  },
  "n-partial-derivative": {
    "prefix": "pd^n",
    "body": "\\frac{\\partial^${3:n} ${1:y}}{\\partial ${2:x}^${3:n}}"
  },
  "integration": {
    "prefix": "int",
    "body": "\\int_{${1:a}}^{${2:b}} ${4:f} \\mathrm{d}${3:x}"
  },
  "differentiation": {
    "prefix": "diff",
    "body": "\\mathrm{d}${1:y} = ${3:f} \\mathrm{d}${2:x}"
  }
}
