[core]
	editor = code --wait
	quotepath = false
	excludesFile = ~/.config/git/ignore
	longpaths = true
[user]
	name = {{ vars.git_name }}
	email = {{ vars.git_email }}
[http]
	sslVerify = true
	sslBackend = schannel
[credential]
	helper = manager
[credential "helperselector"]
	selected = manager
[init]
	defaultBranch = main
[include]
	path = ~/.config/delta/delta.gitconfig
[diff]
	tool = vscode
[difftool "vscode"]
	cmd = code --wait --diff \"$LOCAL\" \"$REMOTE\"
[difftool]
	prompt = false
[fetch]
	prune = true
[safe]
	directory = *
