[core]
	editor = code --wait
	quotepath = false
	excludesFile = ~/.config/git/ignore
[user]
	name = {{ vars.git_name }}
	email = {{ vars.git_email }}
[http]
	sslVerify = true
	sslCAInfo = ~/.certs/git-ca-bundle.crt
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[init]
	defaultBranch = main
[include]
	path = ~/.config/delta/delta.gitconfig
[diff]
	tool = vscode
[difftool "vscode"]
	cmd = code --wait --diff \"$LOCAL\" \"$REMOTE\"
[difftool]
	prompt = false
[fetch]
	prune = true
